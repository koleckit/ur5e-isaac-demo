<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <!-- Give discovery time to match service reply readers before sending a response. -->
    <publisher profile_name="service">
      <qos>
        <reliability>
          <kind>RELIABLE</kind>
          <max_blocking_time><sec>5</sec><nanosec>0</nanosec></max_blocking_time>
        </reliability>
        <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      </qos>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </publisher>
    <publisher profile_name="client">
      <qos>
        <reliability>
          <kind>RELIABLE</kind>
          <max_blocking_time><sec>5</sec><nanosec>0</nanosec></max_blocking_time>
        </reliability>
        <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      </qos>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </publisher>
  </profiles>
</dds>
